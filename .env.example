# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# After creating it, restrict the file so other local users can't read secrets:
#   cp .env.example .env && chmod 600 .env
# On the server, prefer a systemd EnvironmentFile owned by the service user, mode 0600.

# ─── Divoom device (LAN) ──────────────────────────────────────────────────────
DIVOOM_DEVICE_HOST=192.168.178.40
DIVOOM_DEVICE_PORT=9000
DIVOOM_TIMEOUT_MS=45000
# Optional: reuse a previously created local clock id (skip create-on-startup).
# Leave empty on first run; the service logs the new ClockId so you can pin it here.
DIVOOM_CLOCK_ID=
# Native clock layer (disp 4 HOUR_MIN) — font id on the device (24 = DS Digital).
# NOTE: the device must be set to Europe/Berlin + 24h format in the Divoom app;
# the native layer takes time and 12/24h from device settings.
DIVOOM_CLOCK_FONT=24

# ─── Freedom24 / Tradernet (SECRETS) ──────────────────────────────────────────
# Read-only session auth (authByLogin with viewOnlyMode=true).
# API gateway (official docs use tradernet.com/api; freedom24.com/api also works).
FREEDOM_API_URL=https://tradernet.com/api
FREEDOM_LOGIN=
FREEDOM_PASSWORD=
# Optional: account id; if empty the service resolves it via getAccounts on first auth.
FREEDOM_USER_ID=
# Symbols (verified live via getSecurityInfo — adjust if a quote comes back empty).
# NOTE: Tradernet quotes the ruble under its legacy ISO code RUR (not RUB), and
# has no direct Brent benchmark — BRNT.EU (WisdomTree Brent Crude Oil ETC, EUR)
# is a tracker. The card still labels the FX pairs with the familiar "RUB".
FREEDOM_ETF_SYMBOLS=XEON.EU,IQQ0.EU,VUAA.EU,IGLN.EU
FREEDOM_BRENT_SYMBOL=BRNT.EU
FREEDOM_FX_SYMBOLS=EUR/RUR,USD/RUR,CNY/RUR
# Set to true ONLY for E2E debugging: logs raw API response bodies (SID redacted)
# at LOG_LEVEL=debug. Leave false in normal use to avoid logging account data.
FREEDOM_LOG_BODIES=false
# View-only mode (viewOnlyMode). In view-only Tradernet withholds the
# per-position portfolio breakdown (getUserPositions returns an empty pos[]) and
# the real total, so the Портфель page would be empty. DEFAULT = false (full
# read session) so positions are visible. The service ONLY reads
# (getUserPositions / getSecurityInfo / getMarketReviews) and NEVER trades.
# Set true if you accept losing the portfolio page for a non-trading session.
FREEDOM_VIEW_ONLY=false

# ─── favqs.com quotes (SECRET) ────────────────────────────────────────────────
# Register at https://favqs.com → /api_keys. Quotes are English-only.
FAVQS_API_TOKEN=

# ─── Weather (Open-Meteo, NO API key required) ────────────────────────────────
WEATHER_LAT=53.55
WEATHER_LON=9.99
WEATHER_CITY=Гамбург
WEATHER_TZ=Europe/Berlin

# ─── Claude usage widget (OPT-IN, "grey area") ────────────────────────────────
# Shows Claude's unified rate-limit usage — the 5-hour block and weekly window,
# i.e. the same %s as Claude Code's /usage — as a 4th rotating page (two gauges).
# It reads the Claude Code OAuth token from the credentials file and probes the
# Anthropic API to read the anthropic-ratelimit-unified-* response headers.
# Caveats: relies on the subscription OAuth token + rate-limit headers (both
# outside the documented API surface, may break); each poll spends ~1 token of
# the same quota it reports. The credentials file must live on THIS host (e.g.
# install Claude Code on the server and log in under your account).
CLAUDE_USAGE_ENABLED=false
# Path to the Claude Code credentials file (default: ~/.claude/.credentials.json).
CLAUDE_CREDENTIALS_PATH=
# Probe model (cheapest is fine; the headers are account-level, model-agnostic).
CLAUDE_USAGE_MODEL=claude-haiku-4-5-20251001
# Anthropic API base URL (rarely changed).
CLAUDE_API_URL=https://api.anthropic.com

# ─── Misc ─────────────────────────────────────────────────────────────────────
CLOCK_TZ=Europe/Berlin
LOG_LEVEL=info
# Refresh / rotation cadence (Go durations).
FRAME_INTERVAL=13s
WEATHER_INTERVAL=10m
MARKETS_INTERVAL=60s
PORTFOLIO_INTERVAL=90s
NEWS_INTERVAL=5m
QUOTE_INTERVAL=30m
CLAUDE_USAGE_INTERVAL=5m
